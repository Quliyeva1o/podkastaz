{
  "name": "podkast-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed-admin": "node --env-file-if-exists=.env.local --import tsx scripts/seed-admin.mts",
    "test:e2e": "playwright test",
    "db:seed-content": "node --env-file-if-exists=.env.local --import tsx scripts/seed-content.mts",
    "db:seed-collections": "node --env-file-if-exists=.env.local --import tsx scripts/seed-collections.mts",
    "check:launch": "node --env-file-if-exists=.env.local --import tsx scripts/deploy/check-launch.mts",
    "db:reset-content": "node --env-file-if-exists=.env.local --import tsx scripts/reset-content.mts",
    "figma:references": "node --env-file-if-exists=.env.local --import tsx scripts/figma/export-references.mts",
    "figma:assets": "node --env-file-if-exists=.env.local --import tsx scripts/figma/import-assets.mts",
    "visual:capture": "node tests/visual/capture.mjs",
    "visual:compare": "node tests/visual/compare.mjs",
    "visual:pages": "node tests/visual/compare-pages.mjs",
    "perf:vitals": "node tests/perf/measure.mjs",
    "perf:admin": "node --env-file-if-exists=.env.local tests/perf/admin.mjs",
    "media:encode-videos": "node --env-file-if-exists=.env.local --import tsx scripts/encode-videos.mts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
