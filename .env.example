# Copy to .env.local for development. Never commit real values.

# Public site URL (used for canonical URLs, sitemap, OG tags)
SITE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://podkast:podkast@localhost:5441/podkast

# First admin account, created by `npm run db:seed-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Figma REST API token (file_content:read) — only for design export scripts
FIGMA_TOKEN=

# ---- Production only (VPS .env) ----
# DOMAIN=podkast.az
# Other owned domains → 301 to DOMAIN (comma separated; point their DNS to this server too)
# REDIRECT_DOMAINS=podcast.az, www.podcast.az   (to be confirmed: PLAN.md §17)
# POSTGRES_USER=podkast
# POSTGRES_PASSWORD=<long random>
# POSTGRES_DB=podkast
# DATABASE_URL=postgres://podkast:<password>@db:5432/podkast

# ---- Contact form: email notifications (any SMTP provider) ----
# Recipients are set in admin → Ümumi → "Email bildirişləri" (NOTIFY_EMAIL is only a fallback).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=<api key / mailbox password>
# SMTP_FROM="Podkast.az <noreply@podkast.az>"
# NOTIFY_EMAIL=info@podkast.az

# ---- Contact form: spam protection (Cloudflare Turnstile, optional) ----
# Without these keys the form still has honeypot + time trap + per-IP rate limit.
# TURNSTILE_SITE_KEY is baked into the prerendered pages, so it is also a Docker build arg.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# IP_HASH_SALT=<long random string>

# ---- Hosting specifics ----
# cPanel / LiteSpeed: trust only the last X-Forwarded-For entry (the server adds it).
# CLIENT_IP_FROM=last-forwarded
# ffmpeg is not on PATH (shared hosting): full paths to static binaries, e.g. in ~/bin.
# FFMPEG_PATH=
# FFPROBE_PATH=
# The complete production file for cPanel: deploy/cpanel/env.example
