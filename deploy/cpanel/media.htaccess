# Uploaded media, served by the web server straight from ~/marketinq-app/shared/uploads
# (deploy.sh links it into the document root as /media and copies this file there).
# Node never sees these requests: on shared hosting its 2-thread file pool was the bottleneck
# for images and videos, and the app stalled for everyone while they were read.

Options -Indexes

AddType image/avif .avif
AddType image/webp .webp
AddType image/svg+xml .svg
AddType video/mp4 .mp4
AddType video/webm .webm

<IfModule mod_headers.c>
  # Keys contain a unique id, so every file is immutable.
  Header set Cache-Control "public, max-age=31536000, immutable"
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
  </FilesMatch>
</IfModule>

# Uploads are data, never code.
RemoveHandler .php .phtml .php5 .php7 .php8 .phar
RemoveType .php .phtml .php5 .php7 .php8 .phar
<FilesMatch "\.(php|phtml|php5|php7|php8|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
