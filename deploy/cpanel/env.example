# Production settings for the cPanel account → copy to ~/podkast-app/shared/.env
# (chmod 600). Never commit the filled-in file. One KEY=value per line; quote values
# that contain spaces. <account> = the cPanel user name (prefix of databases and paths).

# The chosen domain (podkast.az or podcast.az, PLAN.md §17.1) — canonical URLs, sitemap, emails.
SITE_URL=https://podkast.az
# Test copy only (e.g. https://test.podkast.az): 1 = robots.txt disallows all + X-Robots-Tag noindex.
# Remove it (and rebuild) for the real site.
# SITE_NOINDEX=1

# PostgreSQL database created in cPanel → PostgreSQL Databases (names get the account prefix,
# e.g. <account>_podkast; the user must differ from the database name, e.g. <account>_pkapp).
# Special characters in the password must be URL-encoded (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL=postgres://<account>_pkapp:<password>@localhost:5432/<account>_podkast

# Uploaded media (images, videos) — outside the releases so deploys keep them.
UPLOAD_DIR=/home/<account>/podkast-app/shared/uploads

# LiteSpeed adds the visitor's address as the last X-Forwarded-For entry.
CLIENT_IP_FROM=last-forwarded

# Long random string (e.g. `openssl rand -hex 32`) — salts the hashed IPs of form senders.
IP_HASH_SALT=

# First admin account (`npm run db:seed-admin` in ~/podkast-src). Password ≥ 12 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Booking / package / contact emails through the account's own mail server (a mailbox such as
# noreply@podkast.az created in cPanel → Email Accounts). Recipients: admin → Ayarlar →
# "Email bildirişləri"; NOTIFY_EMAIL is only a fallback.
SMTP_HOST=<mail server of the account, e.g. nl1-cl9-ats3.a2hosting.com>
SMTP_PORT=465
SMTP_USER=noreply@podkast.az
SMTP_PASS=
SMTP_FROM="Podkast.az <noreply@podkast.az>"
NOTIFY_EMAIL=info@podkast.az

# Optional: Cloudflare Turnstile on the forms (the site key is baked into pages at build time).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: a static ffmpeg compresses videos uploaded in the admin (marketinq.az's account
# already has one in ~/bin). Without it, uploaded videos are kept as they are.
# FFMPEG_PATH=/home/<account>/bin/ffmpeg
# FFPROBE_PATH=/home/<account>/bin/ffprobe
